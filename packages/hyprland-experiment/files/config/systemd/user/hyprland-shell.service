[Unit]
Description=Noctalia shell for Hyprland
After=hyprland.service
BindsTo=hyprland.service
PartOf=hyprland.service
Before=xdg-desktop-autostart.target
Before=graphical-session.target
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=exec
TimeoutStartSec=20
ExecStart=/usr/bin/noctalia
ExecStartPost=/usr/local/bin/wait-for-status-notifier-host
Restart=on-failure

[Install]
WantedBy=hyprland.service

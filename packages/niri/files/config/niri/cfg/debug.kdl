// https://niri-wm.github.io/niri/Configuration%3A-Debug-Options.html

debug {
  // Render on the GPU Sunshine captures and encodes on, so screencopy dmabufs stay on
  // one device. `vars.render_gpu.pci` comes from scripts/select_render_gpu.py.
  render-drm-device "/dev/dri/by-path/pci-{{ vars.render_gpu.pci }}-render"

  // Allows notification actions and window activation from Noctalia.
  // bc some of the apps does not implement the valid activation token correctly?
  honor-xdg-activation-with-invalid-serial
}

{
  "$schema": "https://raw.githubusercontent.com/Waishnav/devspace/main/schema/v1/devspace.schema.json",
  "configVersion": 1,

  "server": {
    // Public origin only, never with a trailing /mcp. Rendered from the committed
    // [vars.devspace] public_base_url default; override that var in the untracked
    // ~/.config/dotman/repos/main/local.toml if another host needs its own origin.
    "publicBaseUrl": "{{ vars.devspace.public_base_url }}",
    // Cloudflare terminates TLS and forwards CF-Connecting-IP. This only changes
    // which client IP is recorded in logs.
    "trustProxy": true
  },

  "workspaces": {
    // Roots the ChatGPT connector may open. Keep narrow: anything under a listed
    // root is readable and writable by the connected client.
    "allowedRoots": ["~/Projects"]
  },

  "skills": {
    // Instructions are read from <agentDir>/AGENTS.md, so this loads
    // ~/.agents/AGENTS.md and discovers skills from ~/.agents/skills. Pinned away
    // from the default (~/.codex) so this package depends on `agents` alone
    // instead of on the codex instruction symlink that resolves to the same file.
    "agentDir": "~/.agents"
  }
}

{
	"packages": [
		"npm:pi-mcporter",
		"npm:@howaboua/pi-codex-conversion",
		"npm:@firstpick/pi-extension-btw",
		"git:github.com/ewgdg/pi-agent-coordination",
		"npm:@mtrojnar/pi-usage",
		"npm:@r3b1s/pi-vim-stash"
	],
	"enabledModels": [
		"openai-codex/gpt-5.6-luna",
		"openai-codex/gpt-5.6-sol",
		"deepseek/deepseek-v4-flash",
		"deepseek/deepseek-v4-pro"
	],
	"theme": "dark",
	"pi-openai-controls": {
		"web_search": {
			"mode": "live"
		},
		"service_tier": {
			"default": "auto"
		}
	},
	"compaction": {
		"enabled": true,
		"reserveTokens": 32000
	},
	"treeFilterMode": "default",
	"enableInstallTelemetry": false,
	"terminal": {
		"showTerminalProgress": true,
		"clearOnShrink": true
	},
	"enableSkillCommands": true,
	"pi-select-patch": {
		"anchorMode": "tolerant"
	},
	"extensions": [
		"-extensions/pi-openai-controls/index.ts",
		"+extensions/pi-openrouter-controls/index.ts"
	],
	"fullscreenScrollbar": "always",
	"tuiMode": "fullscreen",
	"retry": {
		"enabled": true
	},
	"skills": [
		"-skills/code-review/SKILL.md",
		"-skills/implement/SKILL.md"
	],
	"fullscreenCopyOnSelect": false
}

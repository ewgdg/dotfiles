{
  "packages": [
    {
      "source": "npm:@howaboua/pi-codex-conversion",
      "extensions": [
        "+dist/index.js"
      ]
    },
    "npm:@firstpick/pi-extension-btw",
    {
      "source": "git:github.com/ewgdg/pi-durable-subagents",
      "extensions": [
        "+src/index.ts"
      ]
    },
    "npm:@r3b1s/pi-vim-stash",
    "npm:@howaboua/pi-codex-web-run",
    "npm:@howaboua/pi-codex-imagegen",
    "npm:pi-antigravity"
  ],
  "enabledModels": [
    "deepseek/deepseek-v4-pro",
    "deepseek/deepseek-flash",
    "antigravity/gemini-3.8-flash",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/muse-spark-1.3-contributor"
  ],
  "theme": "system",
  "pi-openai-controls": {
    "web_search": {
      "mode": "live"
    },
    "service_tier": {
      "default": "auto"
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 32000
  },
  "treeFilterMode": "default",
  "enableInstallTelemetry": false,
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true
  },
  "enableSkillCommands": true,
  "pi-select-patch": {
    "anchorMode": "tolerant"
  },
  "extensions": [
    "-extensions/pi-openai-controls/index.ts",
    "+extensions/pi-openrouter-controls/index.ts"
  ],
  "fullscreenScrollbar": "always",
  "retry": {
    "enabled": true
  },
  "skills": [
    "-skills/code-review/SKILL.md",
    "-skills/implement/SKILL.md"
  ],
  "fullscreenCopyOnSelect": false,
  "defaultTools": [
    "+codemode"
  ]
}

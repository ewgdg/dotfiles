{
	"packages": [
		"npm:pi-vim",
		"npm:pi-mcporter",
		"npm:@howaboua/pi-codex-conversion",
		"git:github.com/ewgdg/pi-multicodex",
		"git:github.com/ewgdg/pi-agent-coordination",
		"npm:pi-btw"
	],
	"enabledModels": [
		"deepseek/deepseek-v4-flash",
		"deepseek/deepseek-v4-pro",
		"codex-lb/gpt-5.6-sol",
		"codex-lb/gpt-5.6-luna"
	],
	"theme": "dark",
	"pi-openai-controls": {
		"web_search": {
			"mode": "live"
		},
		"service_tier": {
			"default": "auto"
		}
	},
	"compaction": {
		"enabled": true,
		"reserveTokens": 22000
	},
	"treeFilterMode": "default",
	"enableInstallTelemetry": false,
	"terminal": {
		"showTerminalProgress": true,
		"clearOnShrink": true
	},
	"enableSkillCommands": true,
	"pi-select-patch": {
		"anchorMode": "tolerant"
	},
	"extensions": [
		"-extensions/pi-openai-controls/index.ts",
		"+extensions/pi-openrouter-controls/index.ts"
	],
	"fullscreenScrollbar": "always",
	"tuiMode": "fullscreen"
}

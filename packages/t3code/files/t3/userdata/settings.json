{
  "storageCleanup": {
    "worktreeAfterDays": 8,
    "worktreeOnMerge": true,
    "worktreeOnDelete": true,
    "worktreeUnchanged": true,
    "browserArtifactsAfterDays": 8,
    "logsAfterDays": 8
  },
  "providers": {
    "cursor": {
      "enabled": false
    },
    "grok": {
      "enabled": false
    },
    "opencode": {
      "enabled": false
    }
  },
  "providerInstances": {
    "pi": {
      "driver": "pi",
      "displayName": "Pi",
      "enabled": true
    },
    "dsh": {
      "driver": "acpRegistry",
      "displayName": "DeepSeek Harness",
      "enabled": true,
      "config": {
        "source": "local",
        "commandPath": "dsh",
        "commandArgs": ["--profile", "acp"]
      }
    }
  }
}

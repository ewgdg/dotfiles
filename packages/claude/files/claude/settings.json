{
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [],
    "deny": [
      "EnterPlanMode"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '~/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/statusline.js\"",
    "refreshInterval": 60
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/subagent-statusline.js\""
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "autoCompactWindow": 300000,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}

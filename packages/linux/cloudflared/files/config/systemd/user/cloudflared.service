[Unit]
Description=Cloudflare Tunnel

[Service]
# exec rather than upstream's notify: readiness reporting buys nothing here and
# exec cannot hang waiting for a notification that never arrives.
Type=exec
# The tunnel is chosen by name from [vars.cloudflared] in the host profile, so no
# UUID is tracked: cloudflared resolves the name and finds its credentials under
# ~/.cloudflared itself. The config file carries only the ingress rules.
#
# --no-autoupdate because the system package manager owns this binary. Upstream's
# own installer adds a daily timer that runs `cloudflared update` as root and
# restarts the service, which would replace the binary behind the manager's back.
#
# No ordering against network-online.target: that is a system target and this is a
# user unit. Restart covers a network that is not up yet.
ExecStart=/usr/bin/cloudflared --no-autoupdate --config %h/.cloudflared/config.yml tunnel run {{ vars.cloudflared.tunnel_name }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target

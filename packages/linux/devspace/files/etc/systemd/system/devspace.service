[Unit]
Description=DevSpace MCP server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=exec
User={{ vars.host.user }}
# A system service inherits neither HOME nor the shell PATH. DevSpace is a node
# CLI that reads its config from the owner's home, and node is taken from the
# stable fnm default alias so a node version change cannot break this unit.
Environment=HOME=/home/{{ vars.host.user }}
Environment=PATH=/home/{{ vars.host.user }}/.local/share/fnm/aliases/default/bin:/home/{{ vars.host.user }}/.npm/bin:/usr/local/bin:/usr/bin
ExecStart=/home/{{ vars.host.user }}/.npm/bin/devspace serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

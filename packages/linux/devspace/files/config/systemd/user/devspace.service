[Unit]
Description=DevSpace MCP server
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=exec
# Run under fnm's default node instead of the inherited PATH's node. DevSpace
# installs better-sqlite3 for the ABI of the node that runs npm, and the
# interactive shells here use fnm (v22.23.1, ABI 127) while the inherited
# /usr/bin/node is 26.x (ABI 147) and cannot load that binding. Delegating to fnm
# keeps version resolution in fnm rather than hardcoding its on-disk layout; it
# adds no multishell entry and fails loudly if the default alias is missing.
ExecStart=fnm exec --using=default -- %h/.npm/bin/devspace serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

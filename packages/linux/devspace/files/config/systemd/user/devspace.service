[Unit]
Description=DevSpace MCP server
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=exec
# Run on the node inherited from the user manager, which is the system node:
# packages/nodejs keeps the global npm prefix built for that node's ABI, and
# better-sqlite3 refuses to load under any other one. The manager's PATH already
# carries %h/.npm/bin and /usr/bin, so no Environment=PATH is needed — and
# Environment= would not expand $PATH anyway.
ExecStart=%h/.npm/bin/devspace serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

[Unit]
Description=Cloudflare Tunnel publishing the DevSpace MCP server

[Service]
# exec rather than upstream's notify: readiness reporting buys nothing here and exec
# cannot hang waiting for a notification that never arrives.
Type=exec
# Named for the tunnel it runs, like the config it reads, so a second tunnel gets its
# own unit instead of claiming cloudflared.service for itself.
#
# The tunnel is chosen by name, so no UUID is tracked: cloudflared resolves the name
# and finds its credentials under ~/.cloudflared itself. The config carries only the
# ingress rules.
#
# --no-autoupdate because pacman owns this binary. Upstream's own installer adds a
# daily timer that runs `cloudflared update` as root and restarts the service, which
# would replace /usr/bin/cloudflared behind pacman's back.
#
# No ordering against network-online.target: that is a system target and this is a
# user unit. Restart covers a network that is not up yet.
ExecStart=/usr/bin/cloudflared --no-autoupdate --config %h/.cloudflared/devspace.yml tunnel run devspace
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target

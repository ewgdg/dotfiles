[Unit]
Description=Wine SNI Bridge - X11 tray to StatusNotifierItem
Documentation=https://github.com/waliori/wine-sni-bridge
# Bind to the graphical session so it starts/stops with the compositor
# (niri, Hyprland, etc. that integrate with systemd's graphical-session.target).
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/wine-sni-bridge --byte-order native
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target

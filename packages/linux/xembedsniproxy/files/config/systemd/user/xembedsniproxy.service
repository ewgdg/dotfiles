[Unit]
Description=XEmbed SNI Proxy - X11 tray to StatusNotifierItem
# Bind to the graphical session so it starts/stops with the compositor
# (niri, Hyprland, etc. that integrate with systemd's graphical-session.target).
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/xembed-sni-proxy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
